[sub_resource type="BTSequence" id="BTSequence_trade"]
custom_name = "Trade"
children = [SubResource("BTCondition_trade"), SubResource("BTAction_trade"), SubResource("BTWait_trade")]

[sub_resource type="BTCondition" id="BTCondition_flee"]
script = ExtResource("5_check_state")
required_state = &"flee"

[sub_resource type="BTAction" id="BTAction_flee_player"]
script = ExtResource("3_find")
group = &"Player"
max_distance = 300.0

[sub_resource type="BTAction" id="BTAction_flee_move"]
script = ExtResource("4_move_target")
tolerance = 200.0

[sub_resource type="BTSequence" id="BTSequence_flee"]
custom_name = "Flee"
children = [SubResource("BTCondition_flee"), SubResource("BTAction_flee_player"), SubResource("BTAction_remember"), SubResource("BTAction_flee_move")]

[sub_resource type="BTSelector" id="BTSelector_states"]
custom_name = "NPC States"
children = [SubResource("BTSequence_talk"), SubResource("BTSequence_work"), SubResource("BTSequence_follow"), SubResource("BTSequence_socialize"), SubResource("BTSequence_travel"), SubResource("BTSequence_trade"), SubResource("BTSequence_flee"), SubResource("BTSequence_wander"), SubResource("BTSequence_idle"), SubResource("BTSequence_sleep")]

[sub_resource type="BTSequence" id="BTSequence_root"]
children = [SubResource("BTAction_schedule"), SubResource("BTSelector_states")]

[resource]
blackboard_plan = SubResource("BlackboardPlan_main")
root_task = SubResource("BTSequence_root")