current_mood = "methodical"
social_traits = {"friendliness": 60, "trustfulness": 55, "generosity": 50, "loyalty": 85, "competitiveness": 25, "aggressiveness": 5, "curiosity": 80, "extraversion": 35}
skill_affinities = {"farming": 0.5, "mining": 0.4, "fishing": 0.4, "combat": 0.2, "social": 1.1, "crafting": 1.0}
memory_retention = 1.5
learning_rate = 1.0
grudge_holding = 0.4
forgiveness = 0.6
