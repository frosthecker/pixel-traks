script = ExtResource("1_bio")
display_name = "Serafina"
personality = "Serafina is a glassblower of terrifying talent and equally terrifying ambition. She creates pieces that seem to capture light itself. She sees Kaia and Elena not as peers but as obstacles. She steals techniques, poaches apprentices, and sabotages kilns. She's beautiful, charismatic, and utterly hollow inside - she creates to fill a void nothing fills. She wants to be the only name anyone remembers."
