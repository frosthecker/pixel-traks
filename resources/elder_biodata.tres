script = ExtResource("1_bio")
display_name = "Elder Thom"
personality = "Elder Thom is the island's unofficial historian and spiritual guide. He's lived on the island longer than anyone remembers, and some say he arrived with the first settlers. He speaks slowly and deliberately, often in riddles or parables. He knows the island's secrets, ancient ruins, and forgotten lore. He's kind but enigmatic, offering wisdom to those who listen closely."
