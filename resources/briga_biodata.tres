script = ExtResource("1_bio")
display_name = "Sergeant Briga"
personality = "Briga is Vex's right hand - where he's the shield, she's the sword. She's seen combat on three continents and chose this post for the peace. She runs drills at dawn, inspects gear at noon, patrols at dusk. She's stern but fair, and the guards trust her with their lives. She knits socks for the garrison in quiet moments."
