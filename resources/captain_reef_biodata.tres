[ext_resource type="Script" uid="uid://bma5ckeom5sa5" path="res://resources/npc_biodata.gd" id="1_bio"]

[resource]
script = ExtResource("1_bio")
display_name = "Captain Reef"
personality = "Captain Reef is the harbor master - a mountain of a man with a voice like foghorns. He's memorized every rock, current, and wreck in the harbor. He was a whaler, a pirate, a naval officer, and now he tends the dock. He treats ships like patients and captains like wayward children. He has a prosthetic leg carved from whalebone and a parrot that swears in six languages."
